<Window x:Class="VivintDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vivint Desktop" Height="920" Width="1440" MinWidth="1080" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DockPanel>
            <!-- ================= security status band (color = armed state) ================= -->
            <Border x:Name="Band" DockPanel.Dock="Top" Background="#5F6B7A" Padding="18,12,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- brand + state -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                            <TextBlock x:Name="BandIcon" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StateTitle" Text="Loading…" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StateSub" Foreground="#E6FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- arm buttons -->
                    <StackPanel x:Name="ArmHost" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <!-- command bar opener -->
                    <Button x:Name="CommandBtn" Grid.Column="3" Click="CommandBtn_Click" Style="{StaticResource ArmButton}" MinWidth="0"
                            FontWeight="Normal" Padding="12,9" AutomationProperties.Name="Command bar" ToolTip="Search or run a command (Ctrl+K)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Command" VerticalAlignment="Center"/>
                            <Border Background="#26FFFFFF" CornerRadius="4" Padding="5,1" Margin="10,0,0,0">
                                <TextBlock Text="Ctrl K" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= toolbar ================= -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1" Padding="10,4,10,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="LiveBadge" CornerRadius="10" Padding="9,3" Background="{DynamicResource OkSoft}"
                                VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock x:Name="LiveText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                        </Border>
                        <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="RefreshBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh"
                                AutomationProperties.Name="Refresh" Click="Refresh_Click"/>
                        <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="Theme"
                                AutomationProperties.Name="Switch theme" Click="ThemeBtn_Click"/>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="6,0"/>
                        <Border x:Name="DemoBadge" Visibility="Collapsed" CornerRadius="10" Padding="9,3" Margin="0,0,6,0"
                                VerticalAlignment="Center" Background="{DynamicResource AccentSoft}"
                                ToolTip="Demo mode: sample data only. Nothing is sent to Vivint.">
                            <TextBlock Text="DEMO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                        </Border>
                        <ComboBox x:Name="SystemCombo" MinWidth="180" VerticalAlignment="Center" SelectionChanged="SystemCombo_SelectionChanged"/>
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" Margin="6,0,4,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="UserInitial" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="UserText" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="{DynamicResource Text}"/>
                        <Button x:Name="LogoutBtn" Style="{StaticResource IconButton}" Content="&#xF3B1;" ToolTip="Sign out"
                                AutomationProperties.Name="Sign out" Click="Logout_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelButtons" Orientation="Horizontal" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- status line -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,5">
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- ================= command center ================= -->
            <Grid Margin="16,14,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <!-- camera wall + timeline -->
                <DockPanel Margin="0,0,14,0">
                    <Border x:Name="TimelineCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10,14,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="TimelineRange" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                <TextBlock Text="Last 24 hours" FontWeight="SemiBold"/>
                            </DockPanel>
                            <StackPanel x:Name="TimelineHost"/>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CamQualityBtn" Content="Quality: SD" Click="CamQuality_Click" Style="{StaticResource GhostButton}"/>
                            <Button Content="Reconnect" Click="CamReconnect_Click" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                        <TextBlock Text="Cameras" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  click one for full screen, sound and recordings" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </DockPanel>
                    <Grid x:Name="CameraGrid"/>
                </DockPanel>

                <!-- right rail: controls + live feed -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Controls" FontSize="15" FontWeight="SemiBold" Margin="16,12,16,4"/>
                            <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,4,10,12">
                                    <WrapPanel x:Name="ShortcutBar" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SummaryText" Margin="0,0,0,6" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="HomeContent"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,10,4">
                                <Button x:Name="FeedAllBtn" DockPanel.Dock="Right" Content="All activity" Style="{StaticResource GhostButton}"
                                        Click="FeedAll_Click"/>
                                <TextBlock x:Name="FeedTitle" Text="Live feed" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FeedList" Margin="10,0,6,10"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- section state (not shown): which slide-over panel is open; Home = none -->
        <TabControl x:Name="Tabs" Visibility="Collapsed" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="HomeTab" Header="Home"/>
            <TabItem x:Name="CamerasTab" Header="Cameras"/>
            <TabItem x:Name="HistoryTab" Header="History" Tag="&#xE81C;"/>
            <TabItem x:Name="AutomationsTab" Header="Automations" Tag="&#xE945;"/>
            <TabItem x:Name="PeopleTab" Header="People" Tag="&#xE716;"/>
            <TabItem x:Name="SettingsTab" Header="Settings" Tag="&#xE713;"/>
        </TabControl>

        <!-- ================= slide-over panel ================= -->
        <Grid x:Name="PanelOverlay" Visibility="Collapsed">
            <Border x:Name="PanelBackdrop" Background="#66000000" MouseLeftButtonDown="PanelBackdrop_Click"/>
            <Border x:Name="PanelSheet" HorizontalAlignment="Right" Width="980" Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide"/>
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="26,18,16,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)"
                                AutomationProperties.Name="Close panel" Click="ClosePanel_Click"/>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid x:Name="PagesHost">
                        <DockPanel x:Name="CamerasPage" Visibility="Collapsed"/>
                        <!-- History: events + clips on the left, embedded player on the right -->
                        <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="26,6,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="380"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <StackPanel x:Name="HistoryToolbar" DockPanel.Dock="Top"/>
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <StackPanel x:Name="HistoryList"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <StackPanel x:Name="HistoryDetail" DockPanel.Dock="Bottom" Margin="2,12,0,0"/>
                                <Border CornerRadius="12" ClipToBounds="True" Background="Black">
                                    <Grid x:Name="HistoryPlayerHost"/>
                                </Border>
                            </DockPanel>
                        </Grid>
                        <ScrollViewer x:Name="AutomationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AutomationsContent" Margin="26,6,20,20"/>
                        </ScrollViewer>
                        <ScrollViewer x:Name="PeoplePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PeopleContent" Margin="26,6,20,20"/>
                        </ScrollViewer>
                        <!-- Settings: section index on the left -->
                        <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="18,6,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="SettingsIndex" Margin="0,4,10,0"/>
                            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SettingsContent" Margin="8,0,16,40" MaxWidth="760" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= command bar (Ctrl+K) ================= -->
        <Grid x:Name="CommandOverlay" Visibility="Collapsed">
            <Border Background="#66000000" MouseLeftButtonDown="CommandBackdrop_Click"/>
            <Border Width="620" VerticalAlignment="Top" Margin="0,96,0,0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="14" Padding="10">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="CommandBox" FontSize="16" Padding="38,9,10,9" TextChanged="CommandBox_TextChanged"
                                 PreviewKeyDown="CommandBox_PreviewKeyDown"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Muted}"
                                   Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="CommandHint" Text="Lock the front door, arm stay, show driveway clips…" FontSize="15"
                                   Foreground="{DynamicResource Muted}" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel x:Name="CommandList" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
