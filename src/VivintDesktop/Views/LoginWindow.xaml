<Window x:Class="VivintDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vivint Desktop — Signed out" Width="1320" Height="840" MinWidth="1040" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        WindowStartupLocation="CenterScreen">
    <!-- The sign-in screen is the main window in its "not connected" state:
         same status band, an idle camera wall and timeline, and the Vivint
         sign-in page sitting in the right rail where controls normally go. -->
    <DockPanel>
        <!-- ================= status band ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Neutral}" Padding="18,12,14,12">
            <DockPanel>
                <Button x:Name="DemoBtn" DockPanel.Dock="Right" Style="{StaticResource ArmButton}" Click="Demo_Click"
                        Padding="14,9" AutomationProperties.Name="Try demo mode"
                        ToolTip="Explore the app with a sample home. Nothing is sent to Vivint.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Try demo mode" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#26FFFFFF">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Not connected" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Vivint Desktop · sign in to see your home" Foreground="#E6FFFFFF" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= status line ================= -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12"
                           Text="Your password goes to Vivint only — this app never sees it."/>
                <TextBlock x:Name="StatusText" Text="Loading Vivint sign-in…" Foreground="{DynamicResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- ================= idle camera wall + timeline ================= -->
            <DockPanel Margin="0,0,14,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10,14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="no data yet" Foreground="{DynamicResource Muted}" FontSize="12"/>
                            <TextBlock Text="Last 24 hours" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ItemsControl x:Name="GhostTimeline"/>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Text="Cameras" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  they'll stream here once you're signed in" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" FontSize="12"/>
                </DockPanel>
                <UniformGrid x:Name="GhostWall" Columns="2" Rows="2"/>
            </DockPanel>

            <!-- ================= right rail: sign in ================= -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                        <Button x:Name="RestartBtn" DockPanel.Dock="Right" Content="Start over" Style="{StaticResource GhostButton}"
                                Click="Restart_Click" Visibility="Collapsed"/>
                        <StackPanel>
                            <TextBlock Text="Sign in to Vivint" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HintText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Asked for a code? Check your email or phone."/>
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
                        <CheckBox x:Name="RememberBox" Content="Keep me signed in on this PC" IsChecked="True"/>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="Placeholder" Text="Connecting to id.vivint.com…" Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Transparent" Margin="1,0,1,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
